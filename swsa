<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COR to Timetable & Lockscreen | USTP</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Class Schedule Maker</h1>
            <p>Upload USTP COR → Editable timetable + Lockscreen wallpaper</p>
        </div>

        <!-- 3-Step Guide -->
        <div class="step-guide">
            <div class="step">
                <div class="step-number">1</div>
                <div class="step-icon">ᯓ➤</div>
                <div class="step-text">Upload COR</div>
                <div class="step-desc">PDF from USTP</div>
            </div>
            <div class="step-arrow">➜</div>
            <div class="step">
                <div class="step-number">2</div>
                <div class="step-icon">✎</div>
                <div class="step-text">Review & Edit</div>
                <div class="step-desc">Click any class to fix</div>
            </div>
            <div class="step-arrow">➜</div>
            <div class="step">
                <div class="step-number">3</div>
                <div class="step-icon">⎙</div>
                <div class="step-text">Get Output</div>
                <div class="step-desc">Wallpaper or Calendar</div>
            </div>
        </div>

        <div class="upload-card">
            <div class="upload-area" onclick="document.getElementById('fileInput').click()">
                <div class="upload-icon"><img src="file_icon.png" width="50" height="60"></div>
                <p>
                    Click to upload your COR PDF
                    <span class="info-tip" data-tooltip="Upload your USTP Certificate of Registration (COR) PDF. Your file stays on your device and is never uploaded.">
                        ⓘ
                    </span>
                </p>
                <small>Your file stays on your device. No upload to any server.</small>
                <input type="file" id="fileInput" accept=".pdf">
            </div>
        </div>

        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p>Extracting your schedule...</p>
        </div>

        <div class="timetable-container" id="timetableContainer">
            <div class="timetable-header">
                <h2>Your Class Schedule</h2>
                <div class="btn-group">
                    <button class="btn-reset" id="resetBtn">↻ Reset</button>
                    <button class="btn-add" id="addCourseBtn">+ Add Class</button>
                    <button class="btn-lockscreen" id="lockscreenBtn">➜] Wallpaper</button>
                </div>
            </div>
            <div class="timetable-grid" id="timetableGrid"></div>

            <!-- ICS Export Button -->
            <div style="display: flex; justify-content: center; margin: 15px 0;">
                <button class="btn-export" id="exportICSBtn">
                    ➜] Export to Calendar (.ics)
                    <span class="info-tip" data-tooltip="Downloads an .ics file that can be imported to Google Calendar, Apple Calendar, or Outlook.">
                        ⓘ
                    </span>
                </button>
            </div>
            
            <p class="tip">
                <strong>Note:</strong> This generator can make mistakes. Please verify your schedule against your COR.<br>
                You can click any class to <strong>edit</strong>, use the <strong>+ Class</strong> button to add new classes, or <strong>delete</strong> incorrect ones by clicking the schedule.
            </p>
        </div>

        <div id="status"></div>
    </div>

