    <!-- ========== MODAL 1: LOCKSCREEN SETTINGS ========== -->
    <div id="lockscreenModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1000; pointer-events: none;">
        <div class="modal-content" style="max-width: 550px; margin: 5% auto; pointer-events: auto; position: relative;">
            <div class="modal-header">
                <h3>Lockscreen Wallpaper Settings</h3>
                <span class="modal-close lockscreen-modal-close">&times;</span>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <div class="form-group">
                    <label>Screen Size</label>
                    <select id="lockscreenSize" style="width: 100%;">
