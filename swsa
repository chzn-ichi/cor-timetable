                            <option value="10:00 PM">10:00 PM</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Room</label>
                    <input type="text" id="editRoom" placeholder="e.g., CITC Lab 3, 51-201">
                </div>
                <div class="form-group">
                    <label>Faculty</label>
