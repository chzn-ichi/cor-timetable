            <div class="modal-footer">
                <button type="button" class="modal-btn delete-btn" id="deleteBtn">Delete</button>
                <button type="button" class="modal-btn cancel-btn" id="cancelBtn">Cancel</button>
                <button type="button" class="modal-btn save-btn" id="saveBtn">Save Changes</button>
            </div>
        </div>
    </div>

